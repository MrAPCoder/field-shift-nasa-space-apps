    "grading": {
      "version": "farm-score-v2",
      "status": "provisional_educational_model_rating",
      "note": "A provisional, educational rating of one simulated historical year from a generic daily soil-water model. It is not a validated assessment of a real farm and does not measure soil health, erosion, yield, profit or crop damage. 100/100 means the scenario met every model target.",
