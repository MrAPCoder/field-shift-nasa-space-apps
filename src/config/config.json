        "cropWater": {
          "label": "Crop water supply",
          "points": 50,
          "factors": {
            "demandMet": { "weight": 25, "fullAt": 0.95, "zeroAt": 0.5, "metric": "Crop-season actual ET / crop water demand (FAO-56 ETo × Kc)." },
            "worstPeriod": { "weight": 12, "fullAt": 0.8, "zeroAt": 0.3, "windowDays": 14, "metric": "Lowest actual ET / demand in any 14-day crop-season window (shortage severity)." },
            "timeAboveStress": { "weight": 7, "fullAt": 0.9, "zeroAt": 0.4, "metric": "Share of crop-season days with storage at or above the crop stress line (water availability through the season)." },
            "longestStress": { "weight": 6, "fullAt": 7, "zeroAt": 45, "metric": "Longest run of consecutive crop-season days below the stress line (stress duration)." }
          }
        },
        "irrigation": {
          "label": "Irrigation use",
          "points": 30,
          "factors": {
            "cropUse": { "weight": 30, "fullAt": 0.8, "zeroAt": 0.3, "metric": "Extra crop-season actual ET caused by irrigation / irrigation applied (paired zero-irrigation run). Its complement is drainage caused by irrigation plus water left in the soil at harvest; drainage is reported, not scored twice." }
          }
        },
        "soilCover": {
          "label": "Rain on exposed soil",
          "points": 20,
          "factors": {
            "exposure": { "weight": 12, "fullAt": 0.3, "zeroAt": 0.9, "metric": "Share of non-freezing NASA precipitation over the year that fell on assumed exposed soil." },
            "heavyExposure": { "weight": 8, "fullAt": 0.3, "zeroAt": 0.9, "heavyDayMm": 12.7, "metric": "Same share for non-freezing days with at least 12.7 mm (0.5 in) of precipitation. Provisional heavier-day convention; daily totals do not measure rainfall intensity." }
          }
        }
      },
